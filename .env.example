DATABASE_PATH=data/plotter.db

# Pi gateway base URL (REST at /api/*, telemetry WebSocket at /ws).
# For development without hardware run `pnpm gateway:mock` and use http://localhost:8080.
# Use http://127.0.0.1:8080 when Plotter Studio runs on the same Pi as the gateway.
GATEWAY_URL=http://plotter-pi.local:8080

# Optional: where drawings land on the bed (svg-to-gcode quadrant 1-4 and offsets in mm).
# PLOTTER_QUADRANT=1
# PLOTTER_X_OFFSET=0
# PLOTTER_Y_OFFSET=0

# Optional: where the pen parks after every plot (mm, pen up). PLOTTER_PARK=false turns it off.
# PLOTTER_PARK=true
# PLOTTER_PARK_X=0
# PLOTTER_PARK_Y=0

# Optional: drawing on the back of glass that is read from the other side. true flips every
# plot left-right across the 690 mm page (Plot, Auto plots and uploaded .gcode files).
# Download G-code stays as drawn. Restart the app and the worker after changing it.
# PLOTTER_MIRROR=true

# Optional: pen-path optimiser. Strokes are reordered for less travel; gaps up to
# PLOTTER_BRIDGE_MM are drawn pen-down instead of lifting (0 = never add ink).
# PLOTTER_BRIDGE_MM=1
# PLOTTER_OPTIMIZE=true

# AI Creative Studio. Keep keys server-side; they are never sent to the browser.
# Provider: gemini (default) or groq. Only the chosen provider's settings are needed.
AI_PROVIDER=gemini

# Google Gemini (key from Google AI Studio).
GEMINI_API_KEY=your_gemini_key_here
# One model or a fallback list (free-tier Flash models by default):
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Groq (only when AI_PROVIDER=groq). Needs strict structured output; browser_search for
# web research (e.g. openai/gpt-oss-120b or openai/gpt-oss-20b).
# GROQ_API_KEY=gsk_your_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# Thinking counts toward this limit; Gemini can use 4,000–7,000 tokens thinking.
AI_MAX_OUTPUT_TOKENS=16000
# Google Search isn't in the Gemini Free Tier; keep this false there.
AI_ENABLE_WEB_SEARCH=false
AI_SVG_WIDTH_MM=690
AI_SVG_HEIGHT_MM=290

# Image engines (optional). Each one shows up in AI Studio's engine picker once its key is
# set. They draw a line-art picture that the server traces into pen strokes (line art only).
# FLUX via Pollinations: a secret sk_ key from enter.pollinations.ai (pk_ keys are refused).
# POLLINATIONS_API_KEY=sk_your_key_here
# POLLINATIONS_IMAGE_MODEL=flux
# OpenAI gpt-image (billed per token; DALL·E was retired from the API in May 2026).
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
# low | medium | high | xhigh | max | auto
# OPENAI_IMAGE_QUALITY=low
# low | medium | high | none (leave the setting out)
# OPENAI_IMAGE_COMPLEXITY=low
