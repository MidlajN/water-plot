# Plotter Studio web app (Next.js standalone server). Installed by install.sh, which
# fills in @USER@, @APP_DIR@ and @NODE@.
[Unit]
Description=Plotter Studio web app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
Environment=PORT=3000
# Listen on the network so phones and laptops can open the app.
Environment=HOSTNAME=0.0.0.0
# Values in .env override the ones above.
EnvironmentFile=@APP_DIR@/.env
ExecStartPre=@NODE@ migrate.cjs
ExecStart=@NODE@ server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
